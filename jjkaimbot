-- --- 4. LOGIC ---

-- Fix for buttons not being clickable
MinBtn.MouseButton1Down:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		MainFrame.Size = UDim2.new(0, 200, 0, 50)
		Content.Visible = false
		MinBtn.Text = "+"
	else
		MainFrame.Size = UDim2.new(0, 200, 0, 130)
		Content.Visible = true
		MinBtn.Text = "-"
	end
end)

AimbotBtn.MouseButton1Down:Connect(function()
	aimbotEnabled = not aimbotEnabled
	AimbotBtn.Text = aimbotEnabled and "Aimbot: ON" or "Aimbot: OFF"
	AimbotBtn.BackgroundColor3 = aimbotEnabled and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(100, 0, 0)
end)

-- Slider Fix
local sliderDragging = false
Knob.MouseButton1Down:Connect(function() sliderDragging = true end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliderDragging = false
	end
end)

RunService.RenderStepped:Connect(function()
	if sliderDragging then
		local mousePos = UserInputService:GetMouseLocation().X
		local trackPos = Track.AbsolutePosition.X
		local trackWidth = Track.AbsoluteSize.X
		local percentage = math.clamp((mousePos - trackPos) / trackWidth, 0, 1)
		
		Knob.Position = UDim2.new(percentage, 0, 0.5, 0)
		currentScale = math.floor(4 + (percentage * 46)) -- Range 4 to 50
		SliderLabel.Text = "Range: " .. currentScale
		Mesh.Scale = Vector3.new(currentScale, currentScale, 0.5)
	end
end)

-- Targeting
RunService.Heartbeat:Connect(function()
	local targets = {}
	local visualRadius = currentScale * 0.8
	
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= Player and plr.Character and plr.Character:FindFirstChild("Humanoid") then
			local root = plr.Character:FindFirstChild("HumanoidRootPart")
			if root and plr.Character.Humanoid.Health > 0 then
				local dist = (RootPart.Position - root.Position).Magnitude
				if dist <= visualRadius then
					table.insert(targets, {char = plr.Character, hp = plr.Character.Humanoid.Health, dist = dist})
				end
			end
		end
	end
	
	if #targets > 0 then
		table.sort(targets, function(a, b)
			if a.hp ~= b.hp then return a.hp < b.hp end
			return a.dist < b.dist
		end)
		currentTarget = targets[1].char
		Outline.Adornee = currentTarget
		Outline.Enabled = true
	else
		currentTarget = nil
		Outline.Enabled = false
	end
end)

-- Camera Lock
-- --- THE FORCED MOBILE CAMERA PULL ---
RunService:BindToRenderStep("MobileCameraLock", Enum.RenderPriority.Camera.Value + 1, function()
    -- Check if Aimbot is ON and we have a Target
    if aimbotEnabled and currentTarget and currentTarget.char:FindFirstChild("HumanoidRootPart") then
        local targetRoot = currentTarget.char.HumanoidRootPart
        local myHead = Character:FindFirstChild("Head")
        
        if myHead then
            -- CRITICAL MOBILE FIX: Force Scriptable EVERY FRAME
            -- This stops the mobile "Touch" script from fighting back
            workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
            
            local myPos = myHead.Position
            local enemyPos = targetRoot.Position
            
            -- 1. Calculate the Orbit Direction
            local dist = (myPos - enemyPos).Magnitude
            local directionAway
            
            if dist > 2 then
                directionAway = (myPos - enemyPos).Unit
            else
                -- If standing on them, use the current camera angle to avoid spinning
                directionAway = -workspace.CurrentCamera.CFrame.LookVector
            end
            
            -- 2. Set the View (Head Level + Distance)
            local camDistance = 15
            local finalCamPos = myPos + (directionAway * camDistance)
            
            -- 3. THE PULL: This forces the screen to face the enemy
            workspace.CurrentCamera.CFrame = CFrame.lookAt(finalCamPos, enemyPos)
        end
    else
        -- If no target or aimbot is OFF, let the player move their camera normally
        if workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        end
    end
end)



