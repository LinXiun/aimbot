-- --- 4. LOGIC (MINIMAL) ---
local function updateToggle()
    local targetPos = aimbotEnabled and UDim2.new(0.55, 0, 0.5, 0) or UDim2.new(0.05, 0, 0.5, 0)
    local targetColor = aimbotEnabled and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(100, 0, 0)
    
    TweenService:Create(ToggleKnob, TweenInfo.new(0.2), {Position = targetPos}):Play()
    TweenService:Create(ToggleBG, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
end

ToggleBG.MouseButton1Down:Connect(function()
    aimbotEnabled = not aimbotEnabled
    updateToggle()
end)


-- Targeting (FIXED RANGE MATCH)
RunService.Heartbeat:Connect(function()
    local targets = {}
    -- Use half the scale because magnitude is radius, while mesh scale is diameter
    local actualRadius = currentScale / 2 

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player and plr.Character and plr.Character:FindFirstChild("Humanoid") then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root and plr.Character.Humanoid.Health > 0 then
                local dist = (RootPart.Position - root.Position).Magnitude
                
                -- Now matches the visual edge of the ring
                if dist <= actualRadius then 
                    table.insert(targets, {char = plr.Character, hp = plr.Character.Humanoid.Health, dist = dist})
                end
            end
        end
    end

    if #targets > 0 then
        table.sort(targets, function(a, b)
            if a.hp ~= b.hp then return a.hp < b.hp end
            return a.dist < b.dist
        end)
        currentTarget = targets[1].char
        Outline.Adornee = currentTarget
        Outline.Enabled = true
    else
        currentTarget = nil
        Outline.Enabled = false
    end
end)


-- --- CAMERA & AVATAR LOCK ---
RunService:BindToRenderStep("SmartTetherLock", Enum.RenderPriority.Camera.Value + 1, function()
    if aimbotEnabled and currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") and Character:FindFirstChild("Head") then

        workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable

        local myHeadPos = Character.Head.Position
        local myRootPos = RootPart.Position
        local enemyBodyPos = currentTarget.HumanoidRootPart.Position
        local directionAway = (myHeadPos - enemyBodyPos).Unit
        local flatDist = (Vector3.new(myHeadPos.X, 0, myHeadPos.Z) - Vector3.new(enemyBodyPos.X, 0, enemyBodyPos.Z)).Magnitude

        -- Settings
        local idealDistance = 15 
        local minThreshold = 8   
        local maxThreshold = 25  
        local collisionRange = 12 
        local camHeight = 2

        -- AVATAR LOCK
        local faceTarget = Vector3.new(enemyBodyPos.X, myRootPos.Y, enemyBodyPos.Z)
        RootPart.CFrame = CFrame.lookAt(myRootPos, faceTarget)

        -- CAMERA LOGIC
        if flatDist > collisionRange then
            CCTV_Position = myHeadPos + (directionAway * idealDistance) + Vector3.new(0, camHeight, 0)
        else
            if CCTV_Position == nil then
                CCTV_Position = myHeadPos + (directionAway * idealDistance) + Vector3.new(0, camHeight, 0)
            end
            
            local distToCam = (myHeadPos - CCTV_Position).Magnitude
            if distToCam < minThreshold or distToCam > maxThreshold then
                CCTV_Position = myHeadPos + (directionAway * idealDistance) + Vector3.new(0, camHeight, 0)
            end
        end

        workspace.CurrentCamera.CFrame = CFrame.lookAt(CCTV_Position, enemyBodyPos)

    else
        if workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            CCTV_Position = nil 
        end
    end
end)