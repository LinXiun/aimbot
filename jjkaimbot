-- Roblox LocalScript: Fixed Ring, Outline Targeting, Slider & Camera Lock
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Camera = workspace.CurrentCamera

-- --- CONFIGURATION ---
local MIN_SCALE = 4
local MAX_SCALE = 30
local currentScale = 10
local RING_Y_OFFSET = -3
local aimbotEnabled = false
local currentTarget = nil

-- --- 1. THE RING (PHYSICS FIXED) ---
local Ring = Instance.new("Part")
Ring.Name = "FootRing"
Ring.CanCollide = false
Ring.CanTouch = false
Ring.CanQuery = false
Ring.Massless = true
Ring.Size = Vector3.new(1, 1, 1)
Ring.Material = Enum.Material.Neon
Ring.Color = Color3.fromRGB(255, 0, 0)
Ring.Transparency = 0.3
Ring.Parent = Character

local Mesh = Instance.new("SpecialMesh")
Mesh.MeshType = Enum.MeshType.FileMesh
Mesh.MeshId = "rbxassetid://3270017"
Mesh.Scale = Vector3.new(currentScale, currentScale, 0.5)
Mesh.Parent = Ring

local Weld = Instance.new("Weld")
Weld.Part0 = RootPart
Weld.Part1 = Ring
Weld.C0 = CFrame.new(0, RING_Y_OFFSET, 0) * CFrame.Angles(math.rad(90), 0, 0)
Weld.Parent = Ring

-- --- 2. THE OUTLINE (NOT HIGHLIGHT) ---
local TargetOutline = Instance.new("Highlight")
TargetOutline.FillTransparency = 1 -- Makes the inside clear (Outline Only)
TargetOutline.OutlineColor = Color3.fromRGB(255, 0, 0)
TargetOutline.OutlineTransparency = 0
TargetOutline.Enabled = false
TargetOutline.Parent = game.CoreGui -- Persistent

-- --- 3. THE REFINED GUI ---
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RingSystemUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = Player:WaitForChild("PlayerGui")

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 220, 0, 140)
MainFrame.Position = UDim2.new(0.1, 0, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.ClipsDescendants = true -- Crucial for minimizing
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.Parent = MainFrame

-- Scaler Section (Always Visible)
local SliderFrame = Instance.new("Frame")
SliderFrame.Size = UDim2.new(1, 0, 0, 50)
SliderFrame.BackgroundTransparency = 1
SliderFrame.Parent = MainFrame

local SliderLabel = Instance.new("TextLabel")
SliderLabel.Size = UDim2.new(1, 0, 0, 20)
SliderLabel.Position = UDim2.new(0, 0, 0, 5)
SliderLabel.Text = "Ring Size: " .. currentScale
SliderLabel.TextColor3 = Color3.new(1, 1, 1)
SliderLabel.BackgroundTransparency = 1
SliderLabel.Parent = SliderFrame

local SliderTrack = Instance.new("Frame")
SliderTrack.Size = UDim2.new(0.8, 0, 0, 4)
SliderTrack.Position = UDim2.new(0.1, 0, 0, 35)
SliderTrack.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
SliderTrack.BorderSizePixel = 0
SliderTrack.Parent = SliderFrame

local SliderKnob = Instance.new("TextButton")
SliderKnob.Size = UDim2.new(0, 16, 0, 16)
SliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)
SliderKnob.Position = UDim2.new(0.2, 0, 0.5, 0)
SliderKnob.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
SliderKnob.Text = ""
SliderKnob.Parent = SliderTrack
Instance.new("UICorner", SliderKnob).CornerRadius = UDim.new(1, 0)

-- Collapsible Content
local ContentFrame = Instance.new("Frame")
ContentFrame.Size = UDim2.new(1, 0, 0, 90)
ContentFrame.Position = UDim2.new(0, 0, 0, 50)
ContentFrame.BackgroundTransparency = 1
ContentFrame.Parent = MainFrame

local AimbotBtn = Instance.new("TextButton")
AimbotBtn.Size = UDim2.new(0.8, 0, 0, 35)
AimbotBtn.Position = UDim2.new(0.1, 0, 0, 10)
AimbotBtn.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
AimbotBtn.Text = "Aimbot: OFF"
AimbotBtn.TextColor3 = Color3.new(1, 1, 1)
AimbotBtn.Parent = ContentFrame
Instance.new("UICorner", AimbotBtn)

local MinimizeBtn = Instance.new("TextButton")
MinimizeBtn.Size = UDim2.new(0, 25, 0, 25)
MinimizeBtn.Position = UDim2.new(1, -30, 0, 5)
MinimizeBtn.Text = "-"
MinimizeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
MinimizeBtn.TextColor3 = Color3.new(1, 1, 1)
MinimizeBtn.Parent = MainFrame

-- --- 4. LOGIC ---

-- Improved Slider Dragging
local isDragging = false
SliderKnob.MouseButton1Down:Connect(function() isDragging = true end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = false
	end
end)

RunService.RenderStepped:Connect(function()
	if isDragging then
		local inputPos = UserInputService:GetMouseLocation().X
		local trackAbsPos = SliderTrack.AbsolutePosition.X
		local trackSize = SliderTrack.AbsoluteSize.X
		local relPos = math.clamp((inputPos - trackAbsPos) / trackSize, 0, 1)
		
		SliderKnob.Position = UDim2.new(relPos, 0, 0.5, 0)
		currentScale = math.floor(MIN_SCALE + (relPos * (MAX_SCALE - MIN_SCALE)))
		SliderLabel.Text = "Ring Size: " .. currentScale
		Mesh.Scale = Vector3.new(currentScale, currentScale, 0.5)
	end
end)

-- Minimize Logic
local minimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	MainFrame.Size = minimized and UDim2.new(0, 220, 0, 50) or UDim2.new(0, 220, 0, 140)
	ContentFrame.Visible = not minimized
	MinimizeBtn.Text = minimized and "+" or "-"
end)

-- Aimbot Toggle
AimbotBtn.MouseButton1Click:Connect(function()
	aimbotEnabled = not aimbotEnabled
	AimbotBtn.Text = aimbotEnabled and "Aimbot: ON" or "Aimbot: OFF"
	AimbotBtn.BackgroundColor3 = aimbotEnabled and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(80, 0, 0)
end)

-- Targeting & Aimbot Loop
RunService.Heartbeat:Connect(function()
	local targets = {}
	local ringRadius = (currentScale * 0.8)
	
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= Player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("Humanoid") then
			local tRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			if tRoot then
				local dist = (RootPart.Position - tRoot.Position).Magnitude
				if dist <= ringRadius then
					table.insert(targets, {char = otherPlayer.Character, hp = otherPlayer.Character.Humanoid.Health, dist = dist})
				end
			end
		end
	end
	
	if #targets > 0 then
		table.sort(targets, function(a, b)
			if a.hp ~= b.hp then return a.hp < b.hp end
			return a.dist < b.dist
		end)
		currentTarget = targets[1].char
		TargetOutline.Adornee = currentTarget
		TargetOutline.Enabled = true
	else
		currentTarget = nil
		TargetOutline.Enabled = false
	end
end)

-- Camera Lock Logic (RenderStepped is required to override default camera)
RunService.RenderStepped:Connect(function()
	if aimbotEnabled and currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
		local lookTarget = currentTarget.HumanoidRootPart.Position
		Camera.CFrame = CFrame.new(Camera.CFrame.Position, lookTarget)
	end
end)
