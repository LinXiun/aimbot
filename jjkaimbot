-- Roblox LocalScript: Stabilized Ring, Targeting, & Slider GUI
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- --- CONFIGURATION ---
local MIN_SCALE = 4
local MAX_SCALE = 25
local currentScale = 8
local RING_Y_OFFSET = -3 -- Adjusts height to be exactly at feet level

-- --- 1. THE RING (FIXED PHYSICS) ---
local Ring = Instance.new("Part")
Ring.Name = "VisualRing"
Ring.CanCollide = false -- Set BEFORE parenting to prevent physics glitches
Ring.CanTouch = false
Ring.CanQuery = false
Ring.Massless = true -- Prevents the ring from affecting your weight/physics
Ring.Anchored = false
Ring.Size = Vector3.new(1, 1, 1)
Ring.Material = Enum.Material.Neon
Ring.Color = Color3.fromRGB(255, 0, 0)
Ring.Transparency = 0.2
Ring.Parent = Character

local Mesh = Instance.new("SpecialMesh")
Mesh.MeshType = Enum.MeshType.FileMesh
Mesh.MeshId = "rbxassetid://3270017"
Mesh.Scale = Vector3.new(currentScale, currentScale, 0.5)
Mesh.Parent = Ring

-- Stable Weld to prevent "teleporting"
local Weld = Instance.new("Weld")
Weld.Part0 = RootPart
Weld.Part1 = Ring
Weld.C0 = CFrame.new(0, RING_Y_OFFSET, 0) * CFrame.Angles(math.rad(90), 0, 0)
Weld.Parent = Ring

-- --- 2. THE HIGHLIGHT (TARGETING) ---
local TargetHighlight = Instance.new("Highlight")
TargetHighlight.FillTransparency = 0.5
TargetHighlight.FillColor = Color3.fromRGB(255, 0, 0)
TargetHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
TargetHighlight.Enabled = false
TargetHighlight.Parent = game.CoreGui

-- --- 3. THE REFINED GUI ---
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RingUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = Player:WaitForChild("PlayerGui")

-- Main Container
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 220, 0, 110)
MainFrame.Position = UDim2.new(0.05, 0, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

-- --- SLIDER SECTION (Always Visible) ---
local SliderFrame = Instance.new("Frame")
SliderFrame.Size = UDim2.new(1, -20, 0, 40)
SliderFrame.Position = UDim2.new(0, 10, 0, 10)
SliderFrame.BackgroundTransparency = 1
SliderFrame.Parent = MainFrame

local SliderLabel = Instance.new("TextLabel")
SliderLabel.Size = UDim2.new(1, 0, 0, 15)
SliderLabel.Text = "Ring Size: " .. currentScale
SliderLabel.TextColor3 = Color3.new(1, 1, 1)
SliderLabel.BackgroundTransparency = 1
SliderLabel.TextSize = 14
SliderLabel.Parent = SliderFrame

local SliderTrack = Instance.new("Frame")
SliderTrack.Size = UDim2.new(1, 0, 0, 6)
SliderTrack.Position = UDim2.new(0, 0, 0.7, 0)
SliderTrack.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
SliderTrack.BorderSizePixel = 0
SliderTrack.Parent = SliderFrame

local SliderKnob = Instance.new("TextButton")
SliderKnob.Size = UDim2.new(0, 16, 0, 16)
SliderKnob.Position = UDim2.new(0.2, -8, 0.5, -8) -- Initial pos
SliderKnob.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
SliderKnob.Text = ""
SliderKnob.Parent = SliderTrack

local KnobCorner = Instance.new("UICorner")
KnobCorner.CornerRadius = UDim.new(1, 0)
KnobCorner.Parent = SliderKnob

-- --- CONTENT SECTION (Minimizable) ---
local Content = Instance.new("Frame")
Content.Size = UDim2.new(1, 0, 0, 50)
Content.Position = UDim2.new(0, 0, 0, 50)
Content.BackgroundTransparency = 1
Content.Parent = MainFrame

local Info = Instance.new("TextLabel")
Info.Size = UDim2.new(1, 0, 1, 0)
Info.Text = "Targeting: Low HP > Nearest"
Info.TextColor3 = Color3.fromRGB(150, 150, 150)
Info.TextSize = 12
Info.BackgroundTransparency = 1
Info.Parent = Content

-- --- MINIMIZE BUTTON ---
local MinBtn = Instance.new("TextButton")
MinBtn.Size = UDim2.new(0, 30, 0, 20)
MinBtn.Position = UDim2.new(1, -35, 0, 5)
MinBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
MinBtn.Text = "_"
MinBtn.TextColor3 = Color3.new(1, 1, 1)
MinBtn.Parent = MainFrame

local isMinimized = false
MinBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	Content.Visible = not isMinimized
	MainFrame.Size = isMinimized and UDim2.new(0, 220, 0, 60) or UDim2.new(0, 220, 0, 110)
	MinBtn.Text = isMinimized and "+" or "_"
end)

-- --- 4. SLIDER LOGIC ---
local dragging = false

local function updateSlider()
	local mousePos = UserInputService:GetMouseLocation().X
	local trackPos = SliderTrack.AbsolutePosition.X
	local trackSize = SliderTrack.AbsoluteSize.X
	local percentage = math.clamp((mousePos - trackPos) / trackSize, 0, 1)
	
	SliderKnob.Position = UDim2.new(percentage, -8, 0.5, -8)
	currentScale = math.floor(MIN_SCALE + (percentage * (MAX_SCALE - MIN_SCALE)))
	SliderLabel.Text = "Ring Size: " .. currentScale
	Mesh.Scale = Vector3.new(currentScale, currentScale, 0.5)
end

SliderKnob.MouseButton1Down:Connect(function() dragging = true end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

RunService.RenderStepped:Connect(function()
	if dragging then
		updateSlider()
	end
end)

-- --- 5. TARGETING LOGIC ---
RunService.Heartbeat:Connect(function()
	local potentialTargets = {}
	local ringRadius = (currentScale * 0.8) -- Match visual mesh size
	
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= Player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("Humanoid") then
			local targetRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			if targetRoot then
				local dist = (RootPart.Position - targetRoot.Position).Magnitude
				if dist <= ringRadius then
					table.insert(potentialTargets, {
						char = otherPlayer.Character,
						hp = otherPlayer.Character.Humanoid.Health,
						dist = dist
					})
				end
			end
		end
	end
	
	if #potentialTargets > 0 then
		-- Sort by Low HP first, then Distance
		table.sort(potentialTargets, function(a, b)
			if a.hp ~= b.hp then
				return a.hp < b.hp
			end
			return a.dist < b.dist
		end)
		
		TargetHighlight.Adornee = potentialTargets[1].char
		TargetHighlight.Enabled = true
	else
		TargetHighlight.Enabled = false
	end
end)
