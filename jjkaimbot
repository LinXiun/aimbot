-- Roblox LocalScript: Character Foot Ring
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- 1. Create the Ring Part
local Ring = Instance.new("Part")
Ring.Name = "FollowRing"
Ring.Size = Vector3.new(1, 1, 1) -- Base size, scaled by mesh
Ring.Transparency = 0 -- Fully visible
Ring.Color = Color3.fromRGB(255, 0, 0) -- Pure Red
Ring.CanCollide = false
Ring.CanQuery = false
Ring.CanTouch = false
Ring.CastShadow = false
Ring.Material = Enum.Material.Neon -- Makes it glow slightly
Ring.Parent = Character

-- 2. Add the Ring Mesh (Torus shape)
local Mesh = Instance.new("SpecialMesh")
Mesh.MeshType = Enum.MeshType.FileMesh
Mesh.MeshId = "rbxassetid://3270017" -- Standard Ring Mesh ID
Mesh.Scale = Vector3.new(6, 6, 0.5) -- Adjust these numbers to change the ring size
Mesh.Parent = Ring

-- 3. Position it at the feet
-- We offset it by -3.2 studs (average character height) to stay below view
Ring.CFrame = RootPart.CFrame * CFrame.new(0, -3.2, 0) * CFrame.Angles(math.rad(90), 0, 0)

-- 4. Weld it so it moves with the player automatically
local Weld = Instance.new("WeldConstraint")
Weld.Part0 = Ring
Weld.Part1 = RootPart
Weld.Parent = Ring

print("Red ring initialized below feet level.")
